# Auth.js
AUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_URL="http://localhost:3000"

# Neon
# DATABASE_URL = pooled (runtime / Prisma Client)
# DATABASE_URL_UNPOOLED = direct (prisma.config.ts → migrate/CLI)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Seed
SEED_EMAIL="izky@cerebrizky.local"
SEED_PASSWORD="cerebrizky"
